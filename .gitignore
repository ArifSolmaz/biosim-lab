.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
results/
configs/results/
# The literature benchmark results ARE committed: benchmarks/REPORT.md shows their
# figures and tests/test_benchmarks.py reads their comparison tables.
!benchmarks/*/results/
benchmarks/*/runs/
assets/*.nc
assets/*.parquet
.DS_Store
.pytest_cache/
.venv-cloud/

# LaTeX build artefacts. The explainer PDFs are committed; the intermediate
# files that produce them are not — they change on every build and carry no
# information the .tex does not.
docs/explainer/*.aux
docs/explainer/*.log
docs/explainer/*.out
docs/explainer/*.toc
