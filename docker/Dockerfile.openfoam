# biosim-lab OpenFOAM back-end (Stage 4).
#
# Separate image on purpose: OpenFOAM is ~2 GB and adds nothing to Stages 1-3.
# The main biosim-lab image must never depend on this one.
#
# Status: the case-generation bridge is NOT implemented. This image exists so
# the contract can be exercised — `biosim doctor` inside it reports the
# OpenFOAM back-end as available, and OpenFOAMSolver.setup() raises a
# NotImplementedError that points at the templates.
FROM opencfd/openfoam-default:2312

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN python3 -m venv /opt/biosim && \
    /opt/biosim/bin/pip install --no-cache-dir -e . && \
    /opt/biosim/bin/pip install --no-cache-dir fluidfoam
ENV PATH="/opt/biosim/bin:${PATH}"

# The custom Lagrangian force model must be compiled into DPMFoam; see
# biosim_lab/solvers/solver_openfoam/templates/README.md for the wmake steps.
CMD ["biosim", "doctor"]
