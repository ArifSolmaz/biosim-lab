\@writefile{toc}{\contentsline {section}{\numberline {3}Sound is squeezing}{6}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Standing waves: the part where nothing moves}{6}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A standing pressure wave across the channel. The solid and dashed curves are the two extremes of the pressure swing. At the nodes the pressure never changes; at the antinodes it swings hardest. Cells that are denser and stiffer than water --- which is every cell in the body --- drift towards the nodes.}}{6}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Why a standing wave pushes things}{7}{section.5}\protected@file@percent }
\newlabel{eq:gorkov}{{2}{7}{Why a standing wave pushes things}{equation.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}The contrast factor: two questions, one number}{7}{section.6}\protected@file@percent }
\newlabel{eq:phi}{{4}{8}{The contrast factor: two questions, one number}{equation.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}The one equation the whole device rests on}{8}{section.7}\protected@file@percent }
\newlabel{eq:force}{{5}{8}{The one equation the whole device rests on}{equation.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Why size wins: the $r^2$ law}{9}{section.8}\protected@file@percent }
\newlabel{sec:r2}{{8}{9}{Why size wins: the $r^2$ law}{section.8}{}}
\newlabel{eq:stokes}{{6}{9}{Why size wins: the $r^2$ law}{equation.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}Where the sound comes from: an earthquake on a chip}{9}{section.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The $r^2$ law, simulated. 400 tumour cells (blue) and 400 red blood cells (orange) enter at the two walls and travel \SI {2}{\milli \meter } down the channel, which takes \SI {0.36}{\second }. The tumour cells reach the middle; the red cells barely move. Nothing else is going on in this device.}}{10}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The device in cross-section. A comb-shaped electrode drives a ripple along the crystal surface. Because the ripple travels faster in the crystal (\SI {3979}{\meter \per \second }) than sound does in water (\SI {1497}{\meter \per \second }), it leaks into the liquid at a fixed angle of about $22^\circ $ --- the same reason a straw looks bent in a glass of water. Two such waves sent from opposite sides make the standing pattern.}}{10}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Two things the textbook formula gets wrong here}{11}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}The ruler is the crystal, not the water}{11}{subsection.10.1}\protected@file@percent }
\newlabel{sec:ruler}{{10.1}{11}{The ruler is the crystal, not the water}{subsection.10.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}The sound does not travel straight across}{11}{subsection.10.2}\protected@file@percent }
\newlabel{eq:phieff}{{12}{11}{The sound does not travel straight across}{equation.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11}Life at low Reynolds number: water is honey}{12}{section.11}\protected@file@percent }
\newlabel{sec:lowre}{{11}{12}{Life at low Reynolds number: water is honey}{section.11}{}}
\newlabel{eq:overdamped}{{14}{12}{Life at low Reynolds number: water is honey}{equation.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {12}How the liquid flows: the parabola}{13}{section.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pressure-driven flow in a channel. Zero at the walls, fastest in the middle. A cell near a wall takes much longer to travel the channel than one in the middle --- which is why the simulation has to integrate long enough for the slowest cell, not the average one.}}{13}{figure.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {part}{Part III --- Counting cells with electricity}{14}{part*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {13}A cell is a tiny insulator}{14}{section.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Electric cell-substrate impedance sensing. Current takes the easy route where the electrode is bare and has to squeeze through gaps where cells sit. The measured impedance therefore reports how much of the electrode is covered.}}{14}{figure.caption.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {14}Turning impedance into a growth curve}{14}{section.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Simulated Cell Index over 48 hours, one line per drug dose. All wells grow identically for the first 24 hours; the drug is added at hour 24 and the curves separate by dose. This is the raw output of a real instrument, and this plot is what the simulation reproduces.}}{15}{figure.caption.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {15}IC50: the number a drug is judged by}{15}{section.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Dose--response from the simulated plate, with the fitted curve and the extracted IC50.}}{16}{figure.caption.13}\protected@file@percent }
